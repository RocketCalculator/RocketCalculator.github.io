{"Sheet1": {"dims": "A1:W5", "cells": {"B3": {"v": "This is a simulation of a two-mass yo-yo despinner as documented in NASA Technical Note D-708, \"Theory and Design Curves for a Yo-Yo Despin Mechanism for Satellites\" by J..V. Fedor.  The weights are released when their wires are aligned with the radius vector.   Maximum wire tensile loads are estimated for both phases."}, "D4": {"v": "Standard g, ft/sec2"}, "E4": {"v": "Initial Roll Rate, deg/sec"}, "F4": {"v": "Initial Roll Rate, rad/sec"}, "G4": {"v": "Final Roll Rate,deg/sec"}, "H4": {"v": "Final Roll Rate, rad/sec"}, "I4": {"v": "Spin Ratio, r"}, "J4": {"v": "Roll Moment of Inertia, sl-ft2"}, "K4": {"v": "Initial Wire Drum Radius, in"}, "L4": {"v": "Initial Wire Drum Radius (a), ft"}, "M4": {"v": "Length of Wire, in"}, "N4": {"v": "Length of Wire, ft"}, "O4": {"v": "Wire Weight per Unit Length, lb/in"}, "P4": {"v": "Wire Mass per Unit Length, sl/ft"}, "Q4": {"v": "Total DeSpin Mass, sl"}, "R4": {"v": "DeSpin Weights Mass, sl"}, "S4": {"v": "De Spin Weight, lb"}, "T4": {"v": "Lambda (l), ft2"}, "U4": {"v": "Maximum Phase 1 Wire Tension, lb"}, "V4": {"v": "G"}, "W4": {"v": "Maximum Phase 2 Wire Tension, lb"}, "D5": {"v": 32.174}, "E5": {"v": 2700}, "F5": {"v": 47.1238898038469, "f": "=E5*PI()/180"}, "G5": {"v": 600}, "H5": {"v": 10.471975511966, "f": "=G5*PI()/180"}, "I5": {"v": 0.222222222222222, "f": "=H5/F5"}, "J5": {"v": 2.5}, "K5": {"v": 15}, "L5": {"v": 1.25, "f": "=K5/12"}, "M5": {"v": 206}, "N5": {"v": 17.1666666666667, "f": "=M5/12"}, "O5": {"v": 0.0002083}, "P5": {"v": 7.76900602971343e-05, "f": "=O5*12/D5"}, "Q5": {"v": 0.00470829145071428, "f": "=(1-I5)*J5/((1+I5)*(L5+N5)^2-L5^2)"}, "R5": {"v": 0.00381917187175818, "f": "=Q5-2*P5*N5/3"}, "S5": {"v": 0.0614390179009739, "f": "=D5*R5/2"}, "T5": {"v": 23.0768428213908, "f": "=SQRT(J5/Q5+L5^2)"}, "U5": {"v": 156.256385917103, "f": "=SQRT(27/16)*Q5*T5*F5^2*(1-L5^2/T5^2)/2"}, "V5": {"v": 264.309135802469, "f": "=(1-I5)*J5/(Q5*L5^2)"}, "W5": {"v": 95.4514816818601, "f": "=R5*F5^2*N5*(L5*I5^2/N5+((I5+1)*(N5/L5+1)-I5^2)/(N5/L5))/2"}}}, "Sheet2": {"dims": "A1:A1", "cells": {}}, "Sheet3": {"dims": "A1:A1", "cells": {}}}